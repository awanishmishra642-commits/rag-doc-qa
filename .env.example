# Copy to .env; never commit actual keys.
GROQ_API_KEY=your_groq_key_here
# If inaccessible, choose a model available to your account in Groq Playground.
GROQ_MODEL=llama-3.3-70b-versatile

# Default: all AI inference runs in the cloud.
# Get a separate free evaluation key at https://dashboard.cohere.com/api-keys
# Evaluation is quota-limited and intended for testing, not production hosting.
EMBEDDING_BACKEND=cloud
COHERE_API_KEY=your_cohere_evaluation_key_here
EMBEDDING_MODEL=embed-english-light-v3.0

# Optional original approach: pip install -r requirements-local.txt
# Then set EMBEDDING_BACKEND=local; Cohere key is not needed.
# Local mode runs AI on your CPU and downloads model weights/PyTorch.
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Characters, not tokens. Reduce these for embedding input-length errors.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
